#!/bin/sh
# Git Pre-commit Hook - 防止提交敏感檔案
# 
# 安裝方式（Unix-like 系統）:
#   cp scripts/pre-commit.sample .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#
# Windows (Git Bash):
#   cp scripts/pre-commit.sample .git/hooks/pre-commit

echo "🔍 執行安全檢查..."

# 檢查是否嘗試提交敏感檔案
SENSITIVE_FILES=$(git diff --cached --name-only | grep -E '\.env$|\.env\..*|db/.*\.db|db/.*\.db-wal|db/.*\.db-shm|.*\.pem$|.*\.key$|.*\.p12$')

if [ -n "$SENSITIVE_FILES" ]; then
    echo ""
    echo "❌ 錯誤：檢測到嘗試提交敏感檔案！"
    echo ""
    echo "以下檔案不應提交到版本控制："
    echo "$SENSITIVE_FILES" | sed 's/^/   - /'
    echo ""
    echo "請執行以下步驟："
    echo "1. 檢查 .gitignore 是否包含這些檔案"
    echo "2. 使用 'git reset HEAD <file>' 取消暫存"
    echo "3. 確認檔案已加入 .gitignore"
    echo ""
    exit 1
fi

# 檢查是否包含可疑的密碼或金鑰
SUSPICIOUS_PATTERNS="password.*=.*['\"][^'\"]{8,}|api[_-]?key.*=.*['\"]|secret.*=.*['\"]|token.*=.*['\"]"
SUSPICIOUS_CONTENT=$(git diff --cached -G"$SUSPICIOUS_PATTERNS" --name-only)

if [ -n "$SUSPICIOUS_CONTENT" ]; then
    echo ""
    echo "⚠️  警告：檢測到可能包含硬編碼密碼或金鑰的檔案："
    echo "$SUSPICIOUS_CONTENT" | sed 's/^/   - /'
    echo ""
    echo "請檢查是否有硬編碼的敏感資訊"
    echo "按 Ctrl+C 取消提交，或按 Enter 繼續"
    read -r
fi

# 執行安全檢查腳本（如果存在）
if [ -f "scripts/security-check.js" ]; then
    echo "執行自動安全檢查..."
    node scripts/security-check.js
    if [ $? -ne 0 ]; then
        echo ""
        echo "❌ 安全檢查失敗！請修正問題後再提交"
        echo ""
        exit 1
    fi
fi

echo "✅ 安全檢查通過"
exit 0
