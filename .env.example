# development 或 production
NODE_ENV=
# 必填，營業時區，決定票號何時重新編號，例如 Asia/Taipei
TZ=
# 選填，預設 3000
PORT=
# 必填，32 字元以上的隨機字串
SESSION_SECRET=
# 必填，相對專案根目錄或絕對路徑，例如 db
DB_DIR=

# 必填，逗號分隔的英數代碼，例如 A,B,C,D,E
SERVICE_TYPES=
# 每個代碼各一組名稱與說明，鍵名結尾須與代碼一致
SERVICE_NAME_A=
SERVICE_DESC_A=
SERVICE_NAME_B=
SERVICE_DESC_B=
SERVICE_NAME_C=
SERVICE_DESC_C=
SERVICE_NAME_D=
SERVICE_DESC_D=
SERVICE_NAME_E=
SERVICE_DESC_E=

# 必填，正整數：每個服務別、每個來源 IP 的等候票上限
MAX_WAITING_PER_SERVICE=
MAX_WAITING_PER_CLIENT=
# 必填，可留空：不受來源上限限制的取號機 IP，逗號分隔
KIOSK_IPS=

# 以下 production 必填
# 例如 https://queue.yourcompany.com
PUBLIC_ORIGIN=
# 可跨站呼叫 API 與嵌入取號頁的網站，逗號分隔
ALLOWED_ORIGINS=
# 代理層數、false，或逗號分隔的代理 IP／網段
TRUST_PROXY=
