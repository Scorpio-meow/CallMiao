# Server port
PORT=

# CORS allowed origins (comma-separated). Required in production.
ALLOWED_ORIGINS=

# Public origin used to build QR/public links. Required in production. Example: https://your.domain
PUBLIC_ORIGIN=

# Service codes accepted by the ticket APIs (comma-separated). Required in all environments.
# Must match the service cards in the kiosk/agent UI, e.g. A,B,C,D,E
SERVICE_TYPES=

# Node environment: development | production
NODE_ENV=

# Session signing secret. Required in all environments.
SESSION_SECRET=

# Reverse proxy trust. Required in production.
# Number of proxy hops (e.g. 1 behind a single Nginx), "false" when clients connect directly,
# or a comma-separated list of proxy IPs/subnets (e.g. 127.0.0.1,10.0.0.0/8).
TRUST_PROXY=
