# ============================================
# 叫號機系統環境變數配置檔案
# ============================================
# 
# 📌 重要提醒：
# 1. 此檔案為範本，請複製為 .env 並填入實際值
# 2. .env 檔案包含敏感資訊，絕不可上傳到 Git（已在 .gitignore 中）
# 3. 生產環境必須設定所有標記為【必填】的項目
# 4. localhost 會自動被允許，無需在 ALLOWED_ORIGINS 中列出
#
# ============================================

# --------------------------------------------
# 伺服器基本設定
# --------------------------------------------

# HTTP 服務埠號（預設：3000）
# 範例：PORT=7894
PORT=3000

# Node 運行環境
# development: 開發模式（詳細錯誤訊息、自動允許所有 localhost）
# production:  正式環境（嚴格安全檢查、簡化錯誤訊息）
# 
# 💡 本地開發時建議使用 development 或不設定此變數
# 💡 生產模式下仍會自動允許當前 PORT 的 localhost（方便本地測試）
NODE_ENV=development

# --------------------------------------------
# CORS 跨域資源共享設定
# --------------------------------------------

# 【正式環境必填】允許的前端網域清單（逗號分隔，不要有空格）
# 
# ⚠️  重要：只需列出遠端/公開的 URL，不要包含 localhost
# ✅ localhost 會自動被系統允許（在當前 PORT 上）
# ✅ 開發模式會自動允許所有 localhost 和 127.0.0.1
# 
# 開發環境範例（本地測試）：
# ALLOWED_ORIGINS=
# 
# 正式環境範例（使用自己的網域）：
# ALLOWED_ORIGINS=https://queue.yourcompany.com,https://www.yourcompany.com
# 
# DevTunnel / ngrok 範例：
# ALLOWED_ORIGINS=https://your-tunnel-id.devtunnels.ms
# 
ALLOWED_ORIGINS=

# --------------------------------------------
# 公開網址設定
# --------------------------------------------

# 【正式環境建議填寫】系統對外的公開網址（用於生成 QR Code、分享連結等）
# 
# 開發環境：可留空，系統會使用 http://localhost:PORT
# 正式環境：應設定為實際的公開網址
# 
# 範例：
# PUBLIC_ORIGIN=https://queue.yourcompany.com
# PUBLIC_ORIGIN=https://your-tunnel-id.devtunnels.ms
# 
PUBLIC_ORIGIN=

# --------------------------------------------
# 資料庫設定（SQLite）
# --------------------------------------------

# SQLite 資料庫檔案路徑（相對於專案根目錄）
# 預設：db/queue.db
# 💡 資料庫檔案會自動建立，無需手動建立
# DB_PATH=db/queue.db

# 資料庫忙碌逾時（毫秒）
# 當資料庫被鎖定時，最多等待多久
# DB_BUSY_TIMEOUT=5000

# --------------------------------------------
# Session / Token 設定（選用）
# --------------------------------------------

# Session 過期時間（秒）
# SESSION_EXPIRE=3600

# CSRF Token 過期時間（秒）
# CSRF_EXPIRE=900

# Captcha 驗證碼過期時間（秒）
# CAPTCHA_EXPIRE=300

# --------------------------------------------
# 速率限制設定（選用）
# --------------------------------------------

# 一般 API 速率限制（每分鐘最多請求數）
# RATE_LIMIT_COMMON=120

# 登入 API 速率限制（每 10 分鐘最多請求數）
# RATE_LIMIT_LOGIN=30

# Captcha API 速率限制（每 5 分鐘最多請求數）
# RATE_LIMIT_CAPTCHA=60

# --------------------------------------------
# 安全性設定（選用）
# --------------------------------------------

# 管理員預設帳號（僅首次初始化使用）
# ADMIN_ACCOUNT=admin

# 是否啟用詳細錯誤日誌（開發用，正式環境請設為 false）
# VERBOSE_ERRORS=false

# --------------------------------------------
# 其他選用設定
# --------------------------------------------

# 日誌等級：debug, info, warn, error
# LOG_LEVEL=info

# 是否啟用 Socket.IO 除錯
# SOCKET_DEBUG=false

# ============================================
# 📋 常見使用情境範例
# ============================================

# 情境 1：本地開發測試
# -------------------------------------------
# PORT=3000
# NODE_ENV=development
# ALLOWED_ORIGINS=
# PUBLIC_ORIGIN=
# 
# 說明：開發模式會自動允許所有 localhost

# 情境 2：使用 DevTunnel / ngrok 遠端訪問
# -------------------------------------------
# PORT=7894
# NODE_ENV=production
# ALLOWED_ORIGINS=https://your-tunnel-id.devtunnels.ms
# PUBLIC_ORIGIN=https://your-tunnel-id.devtunnels.ms
# 
# 說明：
# - localhost:7894 會自動被允許（本地測試）
# - 遠端 tunnel URL 透過 ALLOWED_ORIGINS 白名單允許

# 情境 3：正式部署到自有伺服器
# -------------------------------------------
# PORT=3000
# NODE_ENV=production
# ALLOWED_ORIGINS=https://queue.yourcompany.com
# PUBLIC_ORIGIN=https://queue.yourcompany.com
# 
# 說明：使用 Nginx 反向代理 + HTTPS

# ============================================
# 🔒 安全檢查清單
# ============================================
#
# 部署到正式環境前，請確認：
# [ ] NODE_ENV 設定為 production
# [ ] ALLOWED_ORIGINS 僅包含 HTTPS 的公開網域（不含 localhost）
# [ ] PUBLIC_ORIGIN 設定為實際公開網址
# [ ] .env 檔案已加入 .gitignore（✅ 已設定）
# [ ] .env 檔案絕不上傳到 Git 或公開儲存庫
# [ ] 資料庫檔案 (db/*.db) 已加入 .gitignore（✅ 已設定）
# [ ] 資料庫檔案權限設定為 600 或更嚴格
# [ ] 已執行 npm run create-admin 建立管理員帳號
# [ ] 已更改所有預設密碼
# [ ] 已啟用 HTTPS（使用 Nginx 或其他反向代理）
# [ ] 已設定防火牆規則（只開放必要埠號）
# [ ] 已設定自動備份機制
# [ ] 已執行 npm run security-check 確認無安全問題
#
# ============================================

# ============================================
# 🛠️ 常用指令
# ============================================
#
# 啟動伺服器：
#   npm start
#
# 開發模式（自動重啟）：
#   npm run dev
#
# 建立管理員帳號：
#   npm run create-admin
#
# 重設管理員密碼：
#   npm run reset-admin -- --generate
#
# 安全性檢查：
#   npm run security-check
#
# ============================================